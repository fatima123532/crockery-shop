# Backend Environment Variables
PORT=3001
JWT_SECRET=crockery-house-super-secret-jwt-2026-change-in-production
NODE_ENV=production

# For split deployment (frontend on Vercel, backend on Render)
# Frontend Vercel needs:
# VITE_API_URL=https://your-backend.onrender.com/api

# For Docker/Render single deployment, leave VITE_API_URL empty - uses /api same origin

# Optional: Database path (default server/crockery.db)
# For production, consider Postgres instead of SQLite
# DATABASE_URL=postgres://user:pass@host:5432/crockery
